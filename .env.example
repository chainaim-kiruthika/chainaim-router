# Variable NAMES only. Real values live in your OS keychain / secrets manager
# and are exported into the gateway's environment at start-up.

# Bearer key clients must send to the gateway (pass --api-key-env CHAINAIM_GATEWAY_KEY)
CHAINAIM_GATEWAY_KEY=

# Per-deployment upstream keys, referenced by "apiKeyEnv" in config/catalog.json
# CHAINAIM_OPENAI_KEY=
# CHAINAIM_ANTHROPIC_KEY=
# CHAINAIM_GPU_CLOUD_KEY=
